# whisper-dictation — example environment file.
#
# For TERMINAL TESTING only. whisper-toggle does not auto-load this file;
# source it into your shell before running:
#
#     set -a; . ./.env; set +a
#     whisper-toggle
#
# For the KDE global shortcut (which does not see your shell), put these in
# ~/.config/environment.d/whisper.conf instead and log out/in. Running
# `./install.sh install --cloud` creates that file for you.
#
# Copy to .env (gitignored) and edit:  cp .env.example .env && chmod 600 .env

# ---- backend ----
# local = offline faster-whisper (default) | cloud = OpenAI API
WHISPER_BACKEND=local

# ---- local backend (WHISPER_BACKEND=local) ----
WHISPER_MODEL=small          # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu           # cpu | cuda
WHISPER_LANG=en              # ISO 639-1 language code

# ---- cloud backend (WHISPER_BACKEND=cloud) ----
# OPENAI_API_KEY=sk-...                       # required for cloud
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe   # gpt-4o-transcribe | gpt-4o-mini-transcribe | whisper-1
# OPENAI_BASE_URL=https://api.openai.com/v1   # override for proxies/compatible endpoints
# WHISPER_HTTP_TIMEOUT=300                     # API request timeout, seconds
# WHISPER_HTTP_RETRIES=2                       # retries on transient 429/5xx

# ---- misc ----
# WHISPER_DEBUG=1                              # archive each session's audio + transcript
# WHISPER_DEBUG_DIR=~/.cache/whisper-dictation
# WHISPER_PAREC_LATENCY_MS=30                  # capture latency; low avoids losing speech start
